# =============================================================================
# TrueNorth Website — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For Railway.com deployment, set these in the Railway dashboard.
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Authentication (JWT) ---
# Required in production. If unset, dev mode activates with auto-admin login.
JWT_SECRET=changeme

# --- Database (MySQL) ---
DATABASE_URL=mysql://user:password@host:3306/truenorth

# --- AI / LLM (OpenRouter or any OpenAI-compatible API) ---
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-xxxxxxxx
OPENAI_MODEL=openai/gpt-4o-mini

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx

# --- Google Maps (optional, for map features) ---
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Analytics (optional) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- App Identity ---
VITE_APP_ID=truenorth
